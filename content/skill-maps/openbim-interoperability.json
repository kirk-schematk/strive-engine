            {
              "slug": "importing-ifc-models",
              "role": "teach",
              "status": "published"
            }
          ]
        },
        {
          "id": "b",
          "text": "Position the link correctly using shared coordinates / the agreed origin",
          "lessons": [
            {
              "planned": "ifc-link-positioning",
              "role": "teach"
            }
          ]
        },
        {
          "id": "c",
          "text": "Confirm the linked data is usable: properties readable, categories mapped, elements selectable for coordination",
          "lessons": [
            {
              "planned": "ifc-link-usable-data",
              "role": "practise"
            }
          ]
        },
        {
          "id": "d",
          "text": "Refresh a link when a new issue arrives without losing local work",
          "lessons": [
            {
              "planned": "ifc-link-refresh",
              "role": "practise"
            }
          ]
        }
      ]
    },
    {
      "skill_id": "SKL-25",
      "level": 3,
      "components": [
